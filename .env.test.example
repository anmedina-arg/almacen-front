# Entorno de TEST: el stack local de Supabase en Docker (ver
# docs/ops/base-local-docker.md). Nunca las credenciales de producción.
# Copiá este archivo a .env.test (gitignoreado). Lo lee vitest.setup.ts.
#
# Los valores de abajo son los default de `supabase start` con los puertos de
# supabase/config.toml. Las dos keys son las demo keys fijas de la CLI local
# (no son secretos: cualquier `supabase start` las imprime). Si cambiás los
# puertos en config.toml, cambialos acá también.

TEST_SUPABASE_URL=http://127.0.0.1:54331
TEST_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
TEST_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Conexión directa a Postgres local (psql, scripts). No se usa en runtime de la app.
TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Las imágenes no se duplican entre entornos — los productos de test siguen
# apuntando al bucket de storage de producción. Usada por next.config.ts
# para whitelistear ese host en next/image al correr `next dev` contra TEST
# (URL del proyecto de producción, Project Settings > API).
NEXT_PUBLIC_IMAGE_STORAGE_URL=
