# Credenciales del proyecto Supabase de TEST — nunca las de producción.
# Copiá este archivo a .env.test (gitignoreado) y completá los valores reales.
# Usado por scripts/restore-test-db.sh y, a partir del ticket #9, por la suite de Vitest.

# Supabase API (Project Settings > API)
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres (Project Settings > Database > Connection string),
# usada por scripts/restore-test-db.sh vía psql. No se usa en runtime de la app.
TEST_DB_URL=
