# WhatsApp Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER_AM=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site URL (REQUIRED for OAuth in production)
# Set this to your production domain (e.g., https://yourdomain.com)
# DO NOT include trailing slash
NEXT_PUBLIC_SITE_URL=
# WhatsApp de ventas de chaskyapp para la landing (solo digitos, con codigo de pais, ej. 5491112345678).
# Es NEXT_PUBLIC_: se incrusta en el build, hay que redeployar en Vercel tras cambiarla.
NEXT_PUBLIC_CHASKY_WHATSAPP=
