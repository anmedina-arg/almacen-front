{
  "name": "almacen-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/test/integration/**\"",
    "test:integration": "vitest run src/test/integration",
    "db:build": "node scripts/build-local-schema.mjs",
    "db:start": "npm run db:build && supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:reset": "npm run db:build && supabase db reset",
    "db:stop": "supabase stop",
    "db:status": "supabase status"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.8.0",
    "@tanstack/react-query": "^5.90.20",
    "@vercel/analytics": "^1.5.0",
    "dompurify": "^3.3.1",
    "next": "15.4.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
