  "narrative": {
    "northStar": "La pared de chapas",
    "overview": "chaskyapp se ve como el frente de un almacén de barrio: una pared pintada de azul cobalto de la que cuelgan chapas esmaltadas. Cada módulo es una chapa; el plan base es la grande. La identidad nace del nombre chasky (chasqui), el mensajero que corre por relevos.",
    "keyCharacteristics": [
      "Pared cobalto drenched; las chapas son los únicos objetos de color.",
      "Lettering condensado pesado en mayúsculas, a gran escala.",
      "Rellenos planos, sin degradados de decoración ni vidrio.",
      "Remaches y descascarados pequeños como único detalle de material.",
      "Un solo momento de movimiento: colgado al cargar y giro al tocar."
    ],
    "rules": [
      {
        "name": "The Enamel Only Rule",
        "body": "El color vive en chapas y botones, nunca como degradado ni como texto de color sin contraste de 4.5:1.",
        "section": "colors"
      },
      {
        "name": "The Sign Lettering Rule",
        "body": "Todo texto de display va en mayúsculas, peso 900 y ancho condensado.",
        "section": "typography"
      },
      {
        "name": "The Hung Plate Rule",
        "body": "La sombra siempre tiene desplazamiento vertical y desenfoque.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do sostener el contraste de 4.5:1 en texto de cuerpo y 3:1 en texto grande.",
      "Do usar un solo momento de movimiento.",
      "Do etiquetar como ejemplo cualquier dato de demostración.",
      "Do respetar prefers-reduced-motion."
    ],
    "donts": [
      "Don't usar plumas, máscaras ni estética inca de souvenir.",
      "Don't usar degradados decorativos, vidrio ni texto degradado.",
      "Don't repetir tarjetas iguales de ícono, título y texto como estructura de página.",
      "Don't inventar precios, clientes ni métricas."
    ]
  }
